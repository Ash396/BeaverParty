# Copy this file to .env and fill it in. Never commit .env.

# Where the site is reachable. The redirect URL registered with Petrock
# must be BASE_URL + /auth/callback.
BASE_URL=http://localhost:3000
PORT=3000

# From the Petrock signup email.
PETROCK_CLIENT_ID=
PETROCK_CLIENT_SECRET=

# Two long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ANON_ID_KEY turns emails into anonymous IDs. If it changes, every account
# gets a new ID, so set it once and keep it.
ANON_ID_KEY=
SESSION_SECRET=

# Optional: comma-separated affiliations allowed in (default: student).
# ALLOWED_AFFILIATIONS=student
